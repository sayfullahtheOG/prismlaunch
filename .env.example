# ---------------------------------------------------------------------------
# Both variables are OPTIONAL and SERVER-ONLY.
#
# Never prefix either with NEXT_PUBLIC_ — that would ship the secret to every
# visitor's browser. Neither is user authentication: PrismLaunch has no
# accounts, sessions, or OAuth of any kind.
# ---------------------------------------------------------------------------

# Raises GitHub's anonymous REST limit from 60 requests/hour to 5,000.
# One repository inspection costs 10–30 requests, so without this an
# unauthenticated demo can be rate-limited after roughly two scans.
# A fine-grained token with NO scopes is enough — public data only.
GITHUB_TOKEN=

# Required for MP4 render output. @remotion/vercel uploads the finished file
# to Vercel Blob from inside the Sandbox; detached renders cannot return the
# video any other way. Create via: Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=
